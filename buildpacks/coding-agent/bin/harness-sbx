#!/usr/bin/env bash

create_tmux_config() {
    local -r tmux_config="${1:-${HOME}/work/.tmux.conf}"
    [[ -e "${tmux_config}" ]] || cat <<-EOF > "${tmux_config}"
		# ── Fix extended-keys warning ─────────────────────────────────────────
		set -g extended-keys on
		
		# ── General Settings ──────────────────────────────────────────────────
		set -g default-terminal "screen-256color"
		set -g base-index 1
		set -g pane-base-index 1
		set -g renumber-windows on
		set -g status-position bottom
		
		# ── Disable vi mode for copy/paste (use emacs-style) ─────────────────
		set -g mode-keys emacs
		
		# ── Key Bindings ──────────────────────────────────────────────────────
		
		# Use Ctrl+a as prefix (avoids conflict with pi's Ctrl+b)
		set -g prefix C-a
		bind C-a send-prefix
		
		# Better pane splitting (splits in current directory)
		bind | split-window -h -c "#{pane_current_path}"
		bind - split-window -v -c "#{pane_current_path}"
		bind c new-window -c "#{pane_current_path}"
		
		# Vim-style pane navigation (Ctrl+a h/j/k/l)
		bind h select-pane -L
		bind j select-pane -D
		bind k select-pane -U
		bind l select-pane -R
		
		# Resize panes with Alt+arrows (easier than Shift+arrows)
		bind -n M-Left resize-pane -L 5
		bind -n M-Right resize-pane -R 5
		bind -n M-Up resize-pane -U 5
		bind -n M-Down resize-pane -D 5
		
		# Swap panes
		bind -r H swap-pane -U
		bind -r J swap-pane -D
		bind -r K swap-pane -U
		bind -r L swap-pane -D
		
		# ── Mouse Support ─────────────────────────────────────────────────────
		set -g mouse on
		
		# ── Scrollback / Copy Mode ────────────────────────────────────────────
		# Use Ctrl+b [ to enter copy mode, then use vim keys or mouse to select
		# Press y to yank (copy) selection
		bind -T copy-mode-vi v send-keys -X begin-selection
		bind -T copy-mode-vi y send-keys -X copy-selection-and-cancel
	EOF
}

main() {
        local -a args=("$@")
        local -i use_last_session=1
        local -i attach=1
        local    harness=pi

        for i in "${!args[@]}"; do
                case "${args[i]}" in
                        --pi)
                                harness='pi'
                                unset 'args[i]'
                                ;;
                        --claude)
                                harness='claude'
                                unset 'args[i]'
                                ;;
                        --codex)
                                harness='codex'
                                unset 'args[i]'
                                ;;
                        --new-session|-n)
                                unset 'args[i]'
                                use_last_session=0
                                ;;
                        --session|-r)
                                use_last_session=0
                                ;;
                        --start)
                                unset 'args[i]'
                                attach=0
                                ;;
                esac
        done

        local -r socket_name="${HOME}/work/.${harness}/tmux/mux.socket"
        local -r tmux_lock="${HOME}/work/.${harness}/tmux/mux.lock"
        local -r tmux_config="${HOME}/work/.tmux.conf"

        if (( attach == 0 )); then
                cd -- "${HOME}/work"
                mkdir -p -- $(dirname "${tmux_lock}")
                exec 4<>"${tmux_lock}"
                flock -x -w 5 4
                trap 'tmux -S "'${socket_name}'" kill-server; exit 0' TERM INT

                while true; do
                        # Find the most recent harness session if any.
                        if (( use_last_session == 1 )) && [[ "${harness}" == "pi" && -d "${PI_CODING_AGENT_DIR:-.}/sessions" ]] ; then
                                while read -r s; do
                                        if [[ "${s}" =~ ^.*_([0-9a-z-]+).jsonl$ ]]; then
                                                args+=("--session" "${BASH_REMATCH[1]}")
                                                                                                break
                                        fi
                                done < <(find "${PI_CODING_AGENT_DIR:-.}/sessions" -name '*.jsonl' -type f -printf '%f\n'|sort -r|head -1)
                        fi

                        # Create a new tmux session if one doesn't exist yet.
                        if ! tmux -S "${socket_name}" has-session -t ${harness}-shell >& /dev/null; then
                                create_tmux_config "${tmux_config}"
                                tmux -f "${tmux_config}" -S "${socket_name}" new-session -d -s ${harness}-shell ${harness} "${args[@]}"
                        fi

                        # Pool until tmux session exits.
                        # Alternative is to start tmux with bash -lc "trap 'tmux wait-for -S pi-end' EXIT; exec pi \"${args[@]}\"
                        # and wait for the signal in the loop with tmux wait-for pi-end, however that wouldn't capture uncatchable signals
                        while tmux -S "${socket_name}" has-session -t ${harness}-shell >& /dev/null; do
                                sleep 1
                        done
                done
        elif [[ -S "${socket_name}" ]]; then
                tmux -S "${socket_name}" has-session -t ${harness}-shell >& /dev/null && exec tmux -S "${socket_name}" attach -t ${harness}-shell || echo "No session"
        fi
}

main "$@"
